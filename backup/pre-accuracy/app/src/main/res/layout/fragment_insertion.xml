<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Insertion Controller" android:textColor="@color/text_primary"
            android:textSize="22sp" android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" app:cardBackgroundColor="@color/surface_elevated"
            app:cardCornerRadius="16dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/insertion_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Ready"
                    android:textColor="@color/success" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="Session duration"
                    android:textColor="@color/text_muted" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/extended_mode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Extended duration mode"
                    android:textColor="@color/text_primary" />
                <Spinner android:id="@+id/duration_spinner" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="6dp" />
                <ProgressBar android:id="@+id/insertion_progress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="10dp"
                    android:layout_marginTop="18dp" android:max="100" android:progress="0" />
                <TextView android:id="@+id/progress_text" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="0 / 0 characters" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/current_line" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="Current line: 0" android:textColor="@color/text_muted" />
                <TextView android:id="@+id/time_remaining" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="Elapsed 00:00  ·  Remaining 00:00"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="14dp">
            <Button android:id="@+id/start_button" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:text="Review and Start" />
            <Button android:id="@+id/pause_button" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="Pause" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/resume_button" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:text="Resume" />
            <Button android:id="@+id/stop_button" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="Stop" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
