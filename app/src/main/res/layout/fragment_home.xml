<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KoolKeys"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connection_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Checking Bluetooth..."
            android:textColor="@color/success" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connect_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="Connect"
            app:cornerRadius="14dp" />

        <com.koolkeys.app.ui.widget.TouchpadView
            android:id="@+id/touchpad"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <Button
                android:id="@+id/left_click"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Left Click" />
            <Space android:layout_width="10dp" android:layout_height="1dp" />
            <Button
                android:id="@+id/right_click"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Right Click" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Keyboard"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="4dp">
                <Button
                    android:id="@+id/key_esc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Esc"
                    style="@style/Widget.Material3.Button.TonalButton" />
                <Button
                    android:id="@+id/key_tab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tab"
                    style="@style/Widget.Material3.Button.TonalButton" />
                <Button
                    android:id="@+id/key_ctrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ctrl"
                    style="@style/Widget.Material3.Button.TonalButton" />
                <Button
                    android:id="@+id/key_alt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alt"
                    style="@style/Widget.Material3.Button.TonalButton" />
                <Button
                    android:id="@+id/key_shift"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shift"
                    style="@style/Widget.Material3.Button.TonalButton" />
                <Button
                    android:id="@+id/key_enter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter"
                    style="@style/Widget.Material3.Button.TonalButton" />
                <Button
                    android:id="@+id/key_backspace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Backspace"
                    style="@style/Widget.Material3.Button.TonalButton" />
            </LinearLayout>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <LinearLayout
                android:id="@+id/function_keys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">
            <Button android:id="@+id/key_left" android:layout_width="52dp" android:layout_height="48dp" android:text="←" />
            <Button android:id="@+id/key_down" android:layout_width="52dp" android:layout_height="48dp" android:text="↓" />
            <Button android:id="@+id/key_up" android:layout_width="52dp" android:layout_height="48dp" android:text="↑" />
            <Button android:id="@+id/key_right" android:layout_width="52dp" android:layout_height="48dp" android:text="→" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/qwerty_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="10"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true" />
        <Button
            android:id="@+id/key_space"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="Space" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
