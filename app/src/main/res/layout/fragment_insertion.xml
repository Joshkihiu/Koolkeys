<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Insertion Controller" android:textColor="@color/text_primary"
            android:textSize="22sp" android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" app:cardBackgroundColor="@color/surface_elevated"
            app:cardCornerRadius="16dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/insertion_status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Ready"
                    android:textColor="@color/success" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="Reference duration"
                    android:textColor="@color/text_muted" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/extended_mode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Use reference duration"
                    android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/insertion_speed_label"
                    android:textColor="@color/text_muted" />
                <Spinner android:id="@+id/insertion_speed_spinner"
                    android:layout_width="match_parent" android:layout_height="48dp" />
                <Spinner android:id="@+id/duration_spinner" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="6dp" />
                <TextView android:id="@+id/duration_reference"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/insertion_send_note"
                    android:textColor="@color/text_muted" android:textSize="12sp" />
                <TextView android:id="@+id/insertion_pace"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textColor="@color/text_muted"
                    android:textSize="12sp" />
                <ProgressBar android:id="@+id/insertion_progress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="10dp"
                    android:layout_marginTop="18dp" android:max="100" android:progress="0" />
                <TextView android:id="@+id/progress_text" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="0 / 0 characters" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/current_line" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="Line 1 of 1" android:textColor="@color/text_muted" />
                <TextView android:id="@+id/current_character" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="@string/insertion_no_next_source" android:textColor="@color/text_muted" />
                <TextView android:id="@+id/current_input_word" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="@string/insertion_no_pending_word"
                    android:textColor="@color/text_primary" android:textStyle="bold"
                    android:fontFamily="monospace" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="@string/insertion_monitor_title"
                    android:textColor="@color/text_muted" android:textSize="12sp" />
                <TextView android:id="@+id/local_input_monitor"
                    android:layout_width="match_parent" android:layout_height="72dp"
                    android:layout_marginTop="4dp" android:background="@color/surface"
                    android:fontFamily="monospace" android:gravity="center_vertical"
                    android:maxLines="3" android:padding="8dp"
                    android:text="@string/insertion_monitor_empty"
                    android:textColor="@color/text_muted" android:textSize="13sp" />
                <TextView android:id="@+id/time_remaining" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="Elapsed 00:00 · Est. local send 00:00"
                    android:textColor="@color/text_muted" />
                <TextView android:id="@+id/insertion_diagnostics"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="14dp">
            <Button android:id="@+id/start_button" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:text="@string/insertion_start_button" />
            <Button android:id="@+id/pause_button" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="Pause" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/resume_button" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:text="Resume" />
            <Button android:id="@+id/stop_button" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="Stop" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
